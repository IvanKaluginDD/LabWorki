<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="LoginWindow" Height="180" Width="800">
    <StackPanel>

        <TextBlock  Text="Логин"/>
        <TextBox  x:Name="LoginTextBox"/>

        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox"/>

        <Button Content="Войти" x:Name="AuthorizathionButton" Click="AuthorizathionButton_Click" Margin="0,10,0,0"/>

        <Button Content="Создать аккаунт" Margin="0,15,0,0" HorizontalAlignment="Center" x:Name="NewAccountButton" Click="NewAccountButton_Click"/>
    </StackPanel>
</Window>
